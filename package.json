{
  "name": "calebkan-com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8787",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8787",
    "types": "wrangler types --env-file .dev.vars.example",
    "typecheck": "npm run types && tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.tests-worker.json",
    "test": "npm run build && tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check": "prettier --check . && npm run typecheck && npm test",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "wrangler": "4.158.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    }
  }
}

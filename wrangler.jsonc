{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "calebkan-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "routes": [
    { "pattern": "www.calebkan.com", "custom_domain": true },
    { "pattern": "calebkan.com", "custom_domain": true },
  ],
  "build": {
    "command": "npm run build",
    "watch_dir": [
      "index.html",
      "callback.html",
      "jemdoc.css",
      "js",
      "favicon",
      "api",
      "worker",
      "scripts",
    ],
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "observability": { "enabled": true, "redact_query_string": true },
}
